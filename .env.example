# Número de WhatsApp de la tienda, sin + ni espacios (código país + 9 + área + número)
NEXT_PUBLIC_WHATSAPP_NUMBER=5492994386853
# URL pública del sitio (para metadata y Open Graph)
NEXT_PUBLIC_SITE_URL=https://iphonevita.vercel.app

# Supabase (catálogo + panel /admin). Sin estas tres la tienda usa data/products.ts
# y /admin muestra la guía de configuración.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
